{
  "manifest_version": 3,
  "name": "Flymagotchi (Virtual Fly)",
  "version": "0.1.0",
  "description": "A living fruit fly in your browser. Feed it and its real feeding circuit — 448 neurons from the Drosophila connectome — fires in real time.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir tu mosca"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/circuit.json",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}